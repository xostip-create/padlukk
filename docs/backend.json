
{
  "entities": {
    "rsvp": {
      "title": "RSVP",
      "description": "An RSVP submission for an event.",
      "type": "object",
      "properties": {
        "fullName": {
          "type": "string",
          "description": "The full name of the person RSVPing."
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "The email address of the person RSVPing."
        },
        "socialHandle": {
          "type": "string",
          "description": "The social media link (Instagram/TikTok)."
        },
        "creativeField": {
          "type": "string",
          "description": "The creative field of the person."
        },
        "location": {
          "type": "string",
          "description": "The city/state of the person."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "The timestamp when the RSVP was submitted."
        }
      },
      "required": ["fullName", "email", "socialHandle", "creativeField", "location", "createdAt"]
    },
    "userProfile": {
        "title": "User Profile",
        "description": "A user's public profile information.",
        "type": "object",
        "properties": {}
    },
    "event": {
      "title": "Event",
      "description": "An event created by an admin.",
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "description": "The title of the event."
        },
        "description": {
          "type": "string",
          "description": "The description of the event."
        },
        "date": {
          "type": "string",
          "format": "date-time",
          "description": "The date and time of the event."
        },
        "imageUrl": {
            "type": "string",
            "format": "uri",
            "description": "The URL of the event's image."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "The timestamp when the event was created."
        }
      },
      "required": ["title", "description", "date", "imageUrl", "createdAt"]
    },
    "membershipApplication": {
      "title": "Membership Application",
      "description": "A submission for community membership.",
      "type": "object",
      "properties": {
        "fullName": { "type": "string" },
        "socialHandle": { "type": "string" },
        "creativeField": { "type": "string" },
        "location": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["fullName", "socialHandle", "creativeField", "location", "createdAt"]
    },
    "editorialPost": {
      "title": "Editorial Post",
      "description": "A blog post or article in the editorial section.",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "slug": { "type": "string" },
        "excerpt": { "type": "string" },
        "content": { "type": "string" },
        "author": { "type": "string" },
        "category": { "type": "string" },
        "imageUrl": { "type": "string", "format": "uri" },
        "publishedAt": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "slug", "excerpt", "content", "author", "category", "imageUrl", "publishedAt", "createdAt"]
    }
  },
  "auth": {
    "providers": ["email"]
  },
  "firestore": {
    "/rsvps/{rsvpId}": {
      "schema": {
        "$ref": "#/entities/rsvp"
      },
      "description": "Collection of RSVP submissions."
    },
    "/users/{userId}": {
        "schema": {
            "$ref": "#/entities/userProfile"
        },
        "description": "User profile documents, keyed by user ID."
    },
    "/events/{eventId}": {
      "schema": {
        "$ref": "#/entities/event"
      },
      "description": "Collection of events."
    },
    "/membershipApplications/{id}": {
      "schema": {
        "$ref": "#/entities/membershipApplication"
      },
      "description": "Collection of membership applications."
    },
    "/editorialPosts/{postId}": {
      "schema": {
        "$ref": "#/entities/editorialPost"
      },
      "description": "Collection of editorial blog posts."
    }
  }
}
