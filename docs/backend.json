
{
  "entities": {
    "rsvp": {
      "title": "RSVP",
      "description": "An RSVP submission for an event.",
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "format": "email",
          "description": "The email address of the person RSVPing."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "The timestamp when the RSVP was submitted."
        }
      },
      "required": ["email", "createdAt"]
    },
    "userProfile": {
        "title": "User Profile",
        "description": "A user's public profile information.",
        "type": "object",
        "properties": {}
    },
    "event": {
      "title": "Event",
      "description": "An event created by an admin.",
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "description": "The title of the event."
        },
        "description": {
          "type": "string",
          "description": "The description of the event."
        },
        "date": {
          "type": "string",
          "format": "date-time",
          "description": "The date and time of the event."
        },
        "imageUrl": {
            "type": "string",
            "format": "uri",
            "description": "The URL of the event's image."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "The timestamp when the event was created."
        }
      },
      "required": ["title", "description", "date", "imageUrl", "createdAt"]
    },
    "membershipApplication": {
      "title": "Membership Application",
      "description": "A submission for community membership.",
      "type": "object",
      "properties": {
        "fullName": { "type": "string" },
        "socialHandle": { "type": "string" },
        "creativeField": { "type": "string" },
        "location": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["fullName", "socialHandle", "creativeField", "location", "createdAt"]
    }
  },
  "auth": {
    "providers": ["email", "google.com"]
  },
  "firestore": {
    "/rsvps/{rsvpId}": {
      "schema": {
        "$ref": "#/entities/rsvp"
      },
      "description": "Collection of RSVP submissions."
    },
    "/users/{userId}": {
        "schema": {
            "$ref": "#/entities/userProfile"
        },
        "description": "User profile documents, keyed by user ID."
    },
    "/events/{eventId}": {
      "schema": {
        "$ref": "#/entities/event"
      },
      "description": "Collection of events."
    },
    "/membershipApplications/{id}": {
      "schema": {
        "$ref": "#/entities/membershipApplication"
      },
      "description": "Collection of membership applications."
    }
  }
}
